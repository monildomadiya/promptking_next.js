# Copy the keys you need into .env.local. Never commit real values.

# ── Database ───────────────────────────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# ── Admin / session ────────────────────────────────────────────────────────
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Cloudinary ─────────────────────────────────────────────────────────────
# Still serves every image that is not a wallpaper, and every wallpaper
# uploaded before R2 was configured.
CLOUDINARY_URL=

# ── Cloudflare R2 (wallpaper files) ────────────────────────────────────────
# Set all five and new wallpaper uploads go to the bucket instead of
# Cloudinary. Leave any of them blank and nothing changes.
# Setup steps: docs/r2-wallpapers.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=promptking-wallpapers

# The bucket's public read address — its custom domain, or its r2.dev URL.
# No trailing slash.
NEXT_PUBLIC_R2_PUBLIC_BASE=https://cdn.promptking.in

# Set to 1 only after Image Transformations are enabled for the zone that
# serves NEXT_PUBLIC_R2_PUBLIC_BASE. Until then the grid loads full-size
# originals: correct, but far heavier than it needs to be.
NEXT_PUBLIC_R2_TRANSFORMS=0
